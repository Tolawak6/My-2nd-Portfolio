# =============================================================
#  Portfolio API - environment variables
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the resulting `.env` file.
# =============================================================

# ---- Server -------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- Database ----------------------------------------------
# Full PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://portfolio_user:change_me@localhost:5432/portfolio_db

# Set to "true" when connecting to a hosted Postgres that requires SSL
# (Render, Railway, Neon, Supabase, ...). Local Postgres usually does not.
DB_SSL=false

# ---- CORS ---------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Add your deployed frontend URL before going to production, e.g.
# CLIENT_URL=https://portfolio.example.com,https://www.portfolio.example.com
CLIENT_URL=http://localhost:5173

# ---- Admin authentication -----------------------------------
# The admin dashboard at /admin is protected by a bearer token that is
# signed by this server. Both values below must be long random strings.
# Generate a pair with:  npm run admin:key
#
# If these are left empty the admin write endpoints stay DISABLED (503)
# rather than falling open. The dashboard is never protected by a password
# that lives in frontend source code.
ADMIN_API_KEY=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=120

# ---- Image uploads (Cloudinary) -----------------------------
# Lets the admin dashboard upload an image from your computer or phone instead
# of pasting a URL. All three values come from the Cloudinary console:
#   Dashboard -> Settings -> API Keys
#
# The API SECRET must never reach the browser. It is used only here, to sign
# each upload after the admin session token has been verified. If these are
# left empty the upload endpoint returns 503 and the dashboard falls back to
# the paste-a-URL field, so a fresh clone still runs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder every upload is filed under, so the account stays tidy.
CLOUDINARY_FOLDER=portfolio/projects

# Rejects oversized uploads before a single byte is forwarded to Cloudinary.
# The browser also downsizes images first, so this is a backstop, not the
# usual path.
MAX_UPLOAD_MB=5

# Override the Cloudinary API host. Only useful for pointing the server at a
# stand-in during automated tests.
# CLOUDINARY_API_BASE=https://api.cloudinary.com

# ---- Rate limiting ------------------------------------------
# The contact form and admin sign-in are rate limited. Limits are strict in
# production (5 contact messages/hour, 10 sign-in attempts/15 min) and relaxed
# when NODE_ENV is not "production" so local testing is not locked out.
# Change NODE_ENV to "production" to exercise the real limits.
